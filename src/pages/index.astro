---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const recentPosts = (await getCollection('blog', ({data}) => !data.draft))
  .sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout title="zipgirl — a digital universe" description="Engineering, ideas and everything in between.">
  <div class="wrap">
    <section class="hero">
      <div>
        <div class="eyebrow">independent portfolio · est. 2026</div>
        <h1>Ideas with<br/><em>intention.</em></h1>
        <p class="hero-copy">An engineer's mind, a curious heart, and a little corner of the internet to bring it all together. I'm zipgirl — documenting what I build, what I learn, and what inspires me.</p>
        <div class="actions"><a class="button" href="/projects/">Explore my work ↗</a><a class="button ghost" href="/about/">A little about me</a></div>
      </div>
      <aside class="hero-stamp"><div class="stamp-top">A DIGITAL FIELD NOTE / 001</div><div class="stamp-mark">z<span style="font-size:.55em">✳</span></div><div class="stamp-bottom">THINK · MAKE · REFINE · REPEAT</div></aside>
    </section>
    <div class="section-head"><div><div class="eyebrow">selected work</div><h2>Things in progress</h2></div><a class="kicker" href="/projects/">all projects ↗</a></div>
    <div class="grid">
      <a class="card" href="/projects/"><div class="meta">01 / operations research</div><h3>Systems, optimized</h3><p>Models and methods for making complex decisions clearer.</p></a>
      <a class="card" href="/projects/"><div class="meta">02 / software</div><h3>Tools that think</h3><p>Small, thoughtful software built to solve real problems.</p></a>
      <a class="card" href="/projects/"><div class="meta">03 / data</div><h3>Signals & stories</h3><p>Turning raw information into useful insight.</p></a>
    </div>
    <hr class="rule"/>
    <div class="section-head"><div><div class="eyebrow">from the notebook</div><h2>Recent writing</h2></div><a class="kicker" href="/blog/">read the journal ↗</a></div>
    {recentPosts.length > 0 ? recentPosts.map(post=><article class="post">
      <div class="post-meta">{post.data.category} · {post.data.date.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric'})}</div>
      <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
      <p>{post.data.description}</p>
    </article>) : <p>New notes are on their way.</p>}
    <div class="section-head" style="margin-top:70px"><div><div class="eyebrow">the universe</div><h2>More to explore</h2></div></div>
    <div class="grid">
      <a class="card" href="/about/"><div class="meta">01 / about</div><h3>The person behind the work</h3><p>Background, interests, skills and current curiosities.</p></a>
      <a class="card" href="/blog/"><div class="meta">02 / blogs</div><h3>Notes from the week</h3><p>Personal reflections, technology and culture.</p></a>
      <a class="card" href="/resources/"><div class="meta">03 / resources</div><h3>A well-kept library</h3><p>Tools, references and things worth sharing.</p></a>
    </div>
  </div>
</BaseLayout>