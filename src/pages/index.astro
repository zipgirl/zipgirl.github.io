---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
const recentPosts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const dateOptions: Intl.DateTimeFormatOptions={year:'numeric',month:'long',day:'numeric',timeZone:'America/Argentina/Buenos_Aires'};
---
<BaseLayout title="zipgirl - un universo digital" description="Ingeniería, ideas y todo lo que hay en el medio.">
<div class="wrap"><section class="hero"><div><div class="eyebrow">portfolio independiente · desde 2026</div><h1>Ideas con<br/><em>intención.</em></h1><p class="hero-copy">Una mente curiosa, una mirada analítica y un rincón propio en internet para conectar todo lo que me interesa. Soy zipgirl: acá documento lo que creo, lo que aprendo y lo que me inspira.</p><div class="actions"><a class="button" href="/projects/">Ver mis proyectos ↗</a><a class="button ghost" href="/about/">Un poco sobre mí</a></div></div><aside class="hero-stamp"><div class="stamp-top">BITÁCORA DIGITAL / 001</div><div class="stamp-mark">z<span style="font-size:.55em">✳</span></div><div class="stamp-bottom">PENSAR · CREAR · REFINAR · REPETIR</div></aside></section>
<div class="section-head"><div><div class="eyebrow">trabajos seleccionados</div><h2>En proceso</h2></div><a class="kicker" href="/projects/">ver proyectos ↗</a></div><div class="grid">{projects.slice(0,3).map(p=><a class="card project-card" href={`/projects/${p.slug}/`}><div class="meta">{p.number} / {p.category}</div><h3>{p.title}</h3><p>{p.intro}</p><div class="project-bottom"><span class="status">{p.status}</span><span class="project-open">Abrir ficha ↗</span></div></a>)}</div>
<hr class="rule"/><div class="section-head"><div><div class="eyebrow">desde la bitácora</div><h2>Lo último que escribí</h2></div><a class="kicker" href="/blog/">ir al blog ↗</a></div>
{recentPosts.length>0?recentPosts.map(post=><article class="post"><div class="post-meta">{post.data.category==='a girl'?'una chica':post.data.category==='tech'?'tecnología':'cultura y medios'} · {post.data.date.toLocaleDateString('es-AR',dateOptions)}</div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>):<p>Pronto voy a compartir nuevas notas.</p>}
<div class="section-head" style="margin-top:70px"><div><div class="eyebrow">este universo</div><h2>Hay más para explorar</h2></div></div><div class="grid"><a class="card" href="/about/"><div class="meta">01 / sobre mí</div><h3>La persona detrás de las ideas</h3><p>Mi recorrido, mis intereses y las preguntas que me mueven.</p></a><a class="card" href="/blog/"><div class="meta">02 / blog</div><h3>Notas de cada semana</h3><p>Reflexiones personales, tecnología y cultura.</p></a><a class="card" href="/resources/"><div class="meta">03 / recursos</div><h3>Una biblioteca personal</h3><p>Herramientas, referencias y hallazgos para compartir.</p></a></div></div>
</BaseLayout>