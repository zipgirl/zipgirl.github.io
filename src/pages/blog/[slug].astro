---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}))}
const {post}=Astro.props;const {Content}=await render(post);const all=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>a.data.date.valueOf()-b.data.date.valueOf());const index=all.findIndex(p=>p.id===post.id);const words=(post.body??'').trim().split(/\s+/).filter(Boolean).length;const readingTime=Math.max(1,Math.ceil(words/220));const previous=all[index-1],next=all[index+1];const categoryLabel=post.data.category==='a girl'?'Una chica':post.data.category==='tech'?'Tecnología':'Cultura y medios';const dateOptions: Intl.DateTimeFormatOptions={dateStyle:'long',timeStyle:'short',timeZone:'America/Argentina/Buenos_Aires'};
---
<BaseLayout title={`${post.data.title} - ZipGirl`} description={post.data.description}><article class="wrap prose"><a class="kicker" href="/blog/">← Volver al blog</a><div class="eyebrow" style="margin-top:45px">{categoryLabel} · {post.data.date.toLocaleString('es-AR',dateOptions)} hs</div><h1 style="font-size:clamp(3rem,7vw,5.5rem)">{post.data.title}</h1><p style="font-size:1.15rem">{post.data.description}</p><div class="post-meta">{readingTime} min de lectura</div><hr class="rule"/><div class="article-body"><Content /></div>{post.data.bibliography.length>0&&<section><hr class="rule"/><h2>Bibliografía</h2><ul>{post.data.bibliography.map(item=><li>{item.url?<a href={item.url}>{item.label}</a>:item.label}</li>)}</ul></section>}<hr class="rule"/><div class="two-col"><div>{previous&&<a href={`/blog/${previous.id}/`}>← Anterior: {previous.data.title}</a>}</div><div style="text-align:right">{next&&<a href={`/blog/${next.id}/`}>Siguiente: {next.data.title} →</a>}</div></div></article></BaseLayout>