---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const categories=[{label:'Todas',value:'all'},{label:'Una chica',value:'a girl'},{label:'Tecnología',value:'tech'},{label:'Cultura y medios',value:'media'}];
const dateOptions: Intl.DateTimeFormatOptions={year:'numeric',month:'long',day:'numeric',timeZone:'America/Argentina/Buenos_Aires'};
const categoryLabel=(v:string)=>v==='a girl'?'Una chica':v==='tech'?'Tecnología':'Cultura y medios';
---
<BaseLayout title="Blog - zipgirl" description="Reflexiones personales, notas de tecnología y cultura."><div class="wrap"><div class="eyebrow">la bitácora semanal</div><h1>Palabras y<br/><em>mundos.</em></h1><p class="hero-copy">Reflexiones personales, apuntes técnicos y cosas que merecen una segunda mirada.</p><div class="filter-row" role="group" aria-label="Filtrar artículos">{categories.map((c,i)=><button class="filter" data-filter={c.value} aria-pressed={i===0?'true':'false'}>{c.label}</button>)}</div><div id="posts">{posts.map(post=><article class="post" data-category={post.data.category}><div class="post-meta">{categoryLabel(post.data.category)} · {post.data.date.toLocaleDateString('es-AR',dateOptions)}</div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div>{posts.length===0&&<p>Pronto vas a encontrar nuevas notas por acá.</p>}</div><script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const posts=document.querySelectorAll<HTMLElement>('[data-category]');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));posts.forEach(post=>{post.hidden=filter!=='all'&&post.dataset.category!==filter})}));
</script></BaseLayout>