---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[{title:'Butterfly classifier',category:'Análisis de datos',desc:'Una experiencia interactiva que compara una CNN propia con MobileNetV2 para reconocer especies de mariposas.',tags:['TensorFlow','CNN','MobileNetV2'],href:'/butterfly-classifier/'},{title:'Derivation Atelier',category:'Programación',desc:'Un sistema experto interactivo que combina reglas de derivación simbólica con SymPy.',tags:['Python','Experta','SymPy'],href:'/derivation/'},{title:'Estudio de optimización',category:'Ingeniería e IO',desc:'Un espacio para documentar un proyecto de optimización matemática: formulación, restricciones y análisis de sensibilidad.',tags:['Python','Optimización']},{title:'Laboratorio de datos',category:'Análisis de datos',desc:'Un proyecto de análisis: limpieza, exploración, visualización y conclusiones basadas en evidencia.',tags:['Python','Pandas']},{title:'Archivo web personal',category:'Programación',desc:'El sitio de zipgirl: una web estática modular, un sistema de contenidos y una identidad visual propia.',tags:['Astro','CSS','JavaScript']},{title:'Nota de investigación',category:'Académico',desc:'Un espacio para una investigación con referencias, metodología y resultados.',tags:['Investigación','Escritura']},{title:'Una herramienta pequeña y útil',category:'Personal',desc:'Una utilidad simple pensada para resolver un problema cotidiano.',tags:['JavaScript','Experiencia de usuario']},{title:'Experimentos visuales',category:'Creativo',desc:'Estudios visuales, composiciones editoriales y experimentos digitales.',tags:['Diseño','Código creativo']}];
const categories=['Todos','Ingeniería e IO','Programación','Análisis de datos','Académico','Personal','Creativo'];
---
<BaseLayout title="Proyectos - zipgirl" description="Proyectos técnicos, investigaciones y experimentos creativos."><div class="wrap"><div class="eyebrow">trabajos y experimentos</div><h1>Hechos con<br/><em>curiosidad.</em></h1><p class="hero-copy">Un archivo en crecimiento de proyectos técnicos, investigaciones y pequeñas exploraciones creativas.</p><div class="filter-row" role="group" aria-label="Filtrar proyectos">{categories.map((c,i)=><button class="filter" data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><div class="grid" id="project-grid">{projects.map((p,i)=><a class="card project-card" data-category={p.category} href={p.href ?? '/projects/'}><div class="meta">{String(i+1).padStart(2,'0')} / {p.category}</div><h3>{p.title}</h3><p>{p.desc}</p><div>{p.tags.map(t=><span class="tag">{t}</span>)}</div><p class="kicker">{p.href ? 'explorar proyecto ↗' : 'proyecto en preparación ↗'}</p></a>)}</div></div><script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('.project-card');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));cards.forEach(card=>{card.hidden=filter!=='Todos'&&card.dataset.category!==filter})}));
</script></BaseLayout>