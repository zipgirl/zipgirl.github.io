---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects as allProjects } from '../data/projects';
const projects=[...allProjects].sort((a,b)=>Date.parse(b.updatedAt)-Date.parse(a.updatedAt));
const categories=['Todos','Programación','Análisis de datos'];
---
<BaseLayout title="Proyectos - ZipGirl" description="Proyectos funcionales, herramientas interactivas y experimentos de ZipGirl."><div class="wrap"><div class="eyebrow">trabajos y experimentos</div><h1>Hechos con<br/><em>curiosidad.</em></h1><p class="hero-copy">Un archivo en crecimiento de proyectos interactivos y herramientas que podés explorar.</p><div class="filter-row" role="group" aria-label="Filtrar proyectos">{categories.map((category,index)=><button class="filter" data-filter={category} aria-pressed={index===0?'true':'false'}>{category}</button>)}</div><div class="grid" id="project-grid">{projects.map((project,index)=><a class="card project-card" data-category={project.category} href={project.href} target={project.external?'_blank':undefined} rel={project.external?'noreferrer':undefined}><div class="meta">{String(index+1).padStart(2,'0')} / {project.category}</div><h3>{project.title}</h3><p>{project.description}</p><div>{project.tags.map(tag=><span class="tag">{tag}</span>)}</div><p class="kicker">explorar proyecto ↗</p></a>)}</div></div><script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('.project-card');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));cards.forEach(card=>{card.hidden=filter!=='Todos'&&card.dataset.category!==filter})}));
</script></BaseLayout>