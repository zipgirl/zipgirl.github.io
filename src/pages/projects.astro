---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const categories=['Todos',...new Set(projects.map(p=>p.category))];
---
<BaseLayout title="Proyectos - zipgirl" description="Proyectos técnicos, investigaciones y experimentos creativos.">
<div class="wrap"><div class="eyebrow">trabajos, procesos y experimentos</div><h1>Hechos con<br/><em>curiosidad.</em></h1><p class="hero-copy">Un archivo en crecimiento de proyectos técnicos, investigaciones y pequeñas exploraciones creativas. Cada ficha reúne el contexto, las decisiones y lo que sigue.</p><div class="ornament-divider"><span>✧ ❦ ✧</span></div><div class="filter-row" role="group" aria-label="Filtrar proyectos">{categories.map((c,i)=><button class="filter" data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><div class="grid" id="project-grid">{projects.map(p=><a class="card project-card" href={`/projects/${p.slug}/`} data-category={p.category}><div class="meta">{p.number} / {p.category}</div><h3>{p.title}</h3><p>{p.intro}</p><div>{p.tags.slice(0,3).map(t=><span class="tag">{t}</span>)}</div><div class="project-bottom"><span class="status">{p.status}</span><span class="project-open">Abrir ficha ↗</span></div></a>)}</div></div>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('.project-card');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));cards.forEach(card=>{card.hidden=filter!=='Todos'&&card.dataset.category!==filter})}));
</script>
</BaseLayout>