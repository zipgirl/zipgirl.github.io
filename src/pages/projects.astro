---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = [
  {title:'Optimization study',category:'Engineering & OR',desc:'A placeholder for a mathematical optimization project, including formulation, constraints and sensitivity analysis.',tags:['Python','Optimization']},
  {title:'Data exploration lab',category:'Data Analytics',desc:'A placeholder for an analytical project: cleaning, exploration, visualization and evidence-led conclusions.',tags:['Python','Pandas']},
  {title:'Personal web archive',category:'Programming',desc:'The zipgirl website: a modular static site, content system and custom visual identity.',tags:['Astro','CSS','JavaScript']},
  {title:'Academic research note',category:'Academic',desc:'A placeholder for an academic investigation with references, methodology and findings.',tags:['Research','Writing']},
  {title:'A tiny useful tool',category:'Personal',desc:'A placeholder for a small utility designed around a specific everyday problem.',tags:['JavaScript','UX']},
  {title:'Visual experiments',category:'Creative',desc:'A space for visual studies, editorial layouts and playful digital experiments.',tags:['Design','Creative coding']}
];
const categories = ['All','Engineering & OR','Programming','Data Analytics','Academic','Personal','Creative'];
---
<BaseLayout title="Projects — zipgirl">
  <div class="wrap">
    <div class="eyebrow">selected work & experiments</div><h1>Made with<br/><em>curiosity.</em></h1><p class="hero-copy">A growing archive of technical work, academic investigations and creative side quests.</p>
    <div class="filter-row" role="group" aria-label="Filter projects">{categories.map((c,i)=><button class="filter" data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div>
    <div class="grid" id="project-grid">{projects.map((p,i)=><article class="card project-card" data-category={p.category}><div class="meta">{String(i+1).padStart(2,'0')} / {p.category}</div><h3>{p.title}</h3><p>{p.desc}</p><div>{p.tags.map(t=><span class="tag">{t}</span>)}</div><p class="kicker">case study coming soon ↗</p></article>)}</div>
  </div>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach(card => { card.hidden = filter !== 'All' && card.dataset.category !== filter; });
    }));
  </script>
</BaseLayout>