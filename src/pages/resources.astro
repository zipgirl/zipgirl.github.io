---
import BaseLayout from '../layouts/BaseLayout.astro';
const groups=[{name:'Aprendizaje e investigación',desc:'Libros de consulta, artículos, apuntes y recorridos de aprendizaje.'},{name:'Ingeniería y datos',desc:'Herramientas técnicas, conjuntos de datos, documentación y utilidades de análisis.'},{name:'Práctica creativa',desc:'Referencias de diseño, inspiración visual, escritura y cultura.'},{name:'Sistemas para el día a día',desc:'Aplicaciones, flujos de trabajo y recursos que simplifican la vida.'}];
---
<BaseLayout title="Recursos - zipgirl" description="Una biblioteca personal de herramientas, referencias y recomendaciones."><div class="wrap"><div class="eyebrow">la biblioteca curada</div><h1>Cosas útiles,<br/><em>siempre a mano.</em></h1><p class="hero-copy">Una colección en crecimiento de herramientas, referencias y hallazgos a los que vuelvo o que quiero tener presentes.</p><div class="grid">{groups.map((g,i)=><article class="card"><div class="meta">ESTANTE / 0{i+1}</div><h3>{g.name}</h3><p>{g.desc}</p><span class="kicker">colección en preparación</span></article>)}</div></div></BaseLayout>