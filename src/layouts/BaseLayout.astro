---
import '../styles/global.css';
const { title = 'zipgirl - un universo digital', description = 'Portfolio independiente, bitácora y archivo personal.' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#100b10" /><meta name="description" content={description} /><link rel="canonical" href={Astro.url.href} /><meta property="og:locale" content="es_AR" /><meta property="og:type" content="website" /><meta property="og:site_name" content="zipgirl" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="grain" aria-hidden="true"></div>
<header class="site-header"><a class="brand" href="/" aria-label="Inicio de zipgirl"><span class="brand-word">zipgirl</span><svg class="brand-bow" viewBox="0 0 30 22" aria-hidden="true"><path d="M14 10C8 1 1 1 2 7c.5 4 6 5 12 4Zm2 0c6-9 13-9 12-3-.5 4-6 5-12 4Z" fill="none" stroke="var(--pink)" stroke-width="1.5"/><path d="M13 10 10 21l5-5 5 5-3-11Z" fill="var(--wine)" stroke="var(--pink)" stroke-width="1"/><circle cx="15" cy="10" r="2.2" fill="var(--gold)"/></svg></a><nav aria-label="Navegación principal"><a href="/about/">sobre mí</a><a href="/projects/">proyectos</a><a href="/blog/">blog</a><a href="/resources/">recursos</a></nav><button class="theme-toggle" type="button" aria-label="Cambiar entre tema claro y oscuro">☼</button></header>
<main><slot /></main>
<footer class="site-footer"><span>© {new Date().getFullYear()} zipgirl</span><span>hecho con intención <b>✳</b></span><a href="/about/">sobre mí y contacto ↗</a></footer>
<div class="pixel-cat" aria-hidden="true"><svg class="cat-sprite" viewBox="0 0 32 32" role="presentation" shape-rendering="crispEdges"><ellipse class="cat-shadow" cx="16" cy="28" rx="10" ry="2" fill="#000"/><path class="cat-tail" d="M7 21C2 22 2 17 4 15c1-1 3 0 2 2" fill="none" stroke="#09070b" stroke-width="3" stroke-linecap="square"/><path d="M7 12 7 3 13 8 19 8 25 3 25 13 28 17 27 24 22 27 10 27 5 23 5 17Z" fill="#09070b" stroke="#d58aa8" stroke-width=".65"/><path d="M9 5 12 9 9 10ZM23 5 20 9 23 10Z" fill="#7b344f"/><g class="cat-eyes" fill="#f0b7cd"><rect x="10" y="15" width="3" height="3"/><rect x="20" y="15" width="3" height="3"/></g><path d="M15 19h2v2h-2zM13 22h6" stroke="#d58aa8" stroke-width=".8" fill="none"/><path d="M7 20 2 19M7 22 2 23M25 20 30 19M25 22 30 23" stroke="#d58aa8" stroke-width=".55"/></svg></div>
<script is:inline>
const toggle=document.querySelector('.theme-toggle');const saved=localStorage.getItem('zipgirl-theme');if(saved==='light')document.documentElement.dataset.theme='light';toggle?.addEventListener('click',()=>{const light=document.documentElement.dataset.theme!=='light';document.documentElement.dataset.theme=light?'light':'dark';localStorage.setItem('zipgirl-theme',light?'light':'dark')});
const cat=document.querySelector('.pixel-cat');if(cat&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const states=['cat-walk','cat-stretch','cat-sit','cat-blink'];let i=0;const animate=()=>{cat.classList.remove(...states);const state=states[i++%states.length];cat.classList.add(state);setTimeout(()=>cat.classList.remove(state),state==='cat-blink'?180:2100)};setInterval(animate,6200);setTimeout(()=>{cat.classList.add('cat-away');setTimeout(()=>cat.classList.remove('cat-away'),2200)},17000);setInterval(animate,6200)}
</script>
</body></html>